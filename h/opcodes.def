/* XXX opcodes 0x00 - 0x40 */

OPCODE(NOP, 0x00, nop, "")
OPCODE(HALT, 0x01, halt, "")

OPCODE(LOADLH, 0x02, loadlh, "lh")
OPCODE(LOADLR, 0x03, loadlr, "lr")
OPCODE(LOADRH, 0x0A, loadrh, "rh")
OPCODE(LOADHR, 0x0B, loadhr, "hr")
OPCODE(LOADRR, 0x12, loadrr, "rr")
OPCODE(LOADHH, 0x14, loadhh, "hh")
OPCODE(LOADRFHIR, 0x29, loadrfhir, "rr")
OPCODE(LOADFHIRR, 0x13, loadfhirr, "rr")

OPCODE(PRINTH, 0x04, printh, "h")
OPCODE(PRINTR, 0x05, printr, "r")
OPCODE(PRINTL, 0x06, printl, "l")

OPCODE(JMPL, 0x07, jmpl, "l")
OPCODE(JMPR, 0x08, jmpr, "r")
OPCODE(JMPERR, 0x0C, jmperr, "rr")
OPCODE(JMPERL, 0x0D, jmperl, "rl")
OPCODE(JMPERH, 0x25, jmperh, "rh")
OPCODE(JMPNERL, 0x26, jmpnerl, "rl")
OPCODE(JMPNERR, 0x27, jmpnerr, "rr")
OPCODE(JMPNERH, 0x28, jmpnerh, "rh")
OPCODE(FJMPZRL, 0x2A, fjmpzrl, "rl")
OPCODE(FJMPNERRL, 0x2B, fjmpnerrl, "rrl")
OPCODE(FJMPERRL, 0x2C, fjmperrl, "rrl")
OPCODE(FJMPERLL, 0x2D, fjmperll, "rll")
OPCODE(FJMPNERLL, 0x2E, fjmpnerll, "rll")

OPCODE(LOOPNZRL, 0x41, loopnzrl, "rl")

OPCODE(CMPRRR, 0x09, cmprrr, "rrr")

OPCODE(PUSHR, 0x0E, pushr, "r")
OPCODE(PUSHL, 0x10, pushl, "l")
OPCODE(PUSHH, 0x16, pushh, "h")
OPCODE(POPH, 0x15, poph, "h")
OPCODE(POPR, 0x0F, popr, "r")

OPCODE(INTL, 0x11, intl, "l")

OPCODE(ADDRRR, 0x17, addrrr, "rrr")
OPCODE(ADDLLR, 0x18, addllr, "llr")
OPCODE(ADDHHR, 0x19, addhhr, "hhr")
OPCODE(ADDHHH, 0x1A, addhhh, "hhh")
OPCODE(ADDLRR, 0x1B, addlrr, "lrr")
OPCODE(ADDLHH, 0x42, addlhh, "lhh")
OPCODE(ADDLLH, 0x43, addllh, "llh")
OPCODE(ADDRRH, 0x44, addrrh, "rrh")
OPCODE(ADDLHR, 0x46, addlhr, "lhr")
OPCODE(ADDLRH, 0x47, addlrh, "lrh")

OPCODE(SUBRRR, 0x1C, subrrr, "rrr")
OPCODE(SUBHHH, 0x1D, subhhh, "hhh")
OPCODE(SUBHHR, 0x1E, subhhr, "hhr")
OPCODE(SUBLRR, 0x1F, sublrr, "lrr")
OPCODE(SUBLLR, 0x20, subllr, "llr")
OPCODE(SUBLLH, 0x48, subllh, "llh")
OPCODE(SUBRRH, 0x49, subrrh, "rrh")
OPCODE(SUBLHH, 0x50, sublhh, "lhh")
OPCODE(SUBLHR, 0x51, sublhr, "lhr")
OPCODE(SUBLRH, 0x52, sublrh, "lrh")

OPCODE(MULLLR, 0x32, mulllr, "llr")
OPCODE(MULLRR, 0x33, mullrr, "lrr")
OPCODE(MULLLH, 0x34, mulllh, "llh")
OPCODE(MULRRR, 0x35, mulrrr, "rrr")
OPCODE(MULHHH, 0x36, mulhhh, "hhh")
OPCODE(MULHHR, 0x37, mulhhr, "hhr")
OPCODE(MULRRH, 0x38, mulrrh, "rrh")
OPCODE(MULLHR, 0x39, mullhr, "lhr")
OPCODE(MULLRH, 0x40, mullrh, "lrh")
OPCODE(MULLHH, 0x45, mullhh, "lhh")

OPCODE(DECR, 0x21, decr, "r")
OPCODE(DECH, 0x22, dech, "h")
OPCODE(INCR, 0x23, incr, "r")
OPCODE(INCH, 0x24, inch, "h")

OPCODE(SPAWNLL, 0x2F, spawnll, "ll")
OPCODE(SPAWNRL, 0x30, spawnrl, "rl")
OPCODE(STOP, 0x31, stop, "")

OPCODE(__END, 0x53, __end, "")
