; examlpe of example.src compiled into IR

External Function (Word) strlen (Byte Pointer) Pure
External Function (Word) memcpy (Word Pointer, Word Pointer, Word)
External Function (Word) print (Byte Pointer, Byte Pointer, Word)
External Constant Byte Pointer stdout

Define Constant Byte Pointer str
Define Constant Word len

Initialize                                  ; runs before Entry, in declaration order
	"Hello, World!\0" -> str
	Call Function strlen (str) -> len
Finish Initialize

Entry main

Function (Boolean, Word) main (None)
	Define Byte Pointer buff
	Define Word Pointer src
	Define Word Pointer dst
	Define Word t0
	Define Word nwords
	Define Word r
	Define Boolean ok

	Allocate Bytes len Aligned Word -> buff       ; byte buff[len], rounded up to words
	Add len, 3 -> t0
	Divide t0 By 4 -> nwords                      ; (len + 3) / 4
	Convert str Into Word Pointer Aligned -> src
	Convert buff Into Word Pointer Aligned -> dst
	Call Function memcpy (src, dst, nwords)
	Call Function print (stdout, buff, len) -> r
	Convert r Into Boolean -> ok                  ; the ! needs a bool
	Goto fail If ok != True
	Return (True, 0)
fail:
	Return (False, 1)
Finish Function main
