#include <memory.XXX> /* word memcpy (const word *src, word *dst, word nwords); */
#include <strlen.XXX> /* word strlen (const byte *src); length in bytes, without the NUL */
#include <stdio.XXX>  /* byte *stdout; word print (byte *out, const byte *in, word len); nonzero on success */

const byte str[] = "Hello, World!\n"; /* string literal */
const word len = strlen(str);         /* length in bytes */

bool, word main () {
	byte buff[len];                  /* storage is rounded up to whole words: 16 bytes */
	word nwords = (len) / wordsize;  /* words to copy */
	memcpy((const word *)&str[0], (word *)&buff[0], nwords);
	/* the conversions above are safe: arrays are word aligned and rounded up to whole words */
	if (!print(stdout, &buff[0], len)) return(false, 1);
	return(true, 0);
}
